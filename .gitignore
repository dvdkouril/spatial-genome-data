*.DS_Store

# ignore the input files for datasets (can be downloaded from cloud)
datasets/tan-2018/GSE117876_RAW
datasets/stevens-2017/GSE80280_RAW

# ignore the output files as well (stored in cloud too); datasets/*/out/ below
# covers the dataset folders
processed/for-gosling-designer/out
processed/normalized/out

# marimo files
processed/normalized/__marimo__/*

# local secrets (API keys etc.)
.env

# the agent's papers database (agent/data/papers.csv is its committed backup)
agent/data/papers.db*
# the agent's working folder
agent/work/
# runtime files generated by the Pi agents
agent/auth.json
agent/models-store.json
agent/settings.json
agent/sessions/

# the extraction agent's notebooks: downloads, outputs and marimo's cache stay local
datasets/*/data/
datasets/*/out/
__marimo__/
# except sbif-2021, whose outputs are committed
!datasets/sbif-2021/out/
